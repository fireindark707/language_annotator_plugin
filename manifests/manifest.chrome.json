{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.4.6",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "permissions": ["activeTab", "storage", "unlimitedStorage", "contextMenus"],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://kateglo.lostfocus.org/*",
    "https://freedictionaryapi.com/*",
    "https://jotoba.de/*",
    "https://media.githubusercontent.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["packages/wordfreq.iife.js", "lib/wordfreq-utils.js", "lib/dictionary-utils.js", "lib/lemma-utils.js", "lib/translation-utils.js", "lib/sentence-splitter.js", "lib/example-utils.js", "lib/storage-merge-utils.js", "lib/content-ui.js", "lib/content-addword.js", "lib/content-lookup-ui.js", "lib/content-page-processing.js", "lib/content-difficulty.js", "storage.js", "ui-i18n.js", "ui-tour.js", "ui-toast.js", "content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["packages/sentencex_wasm.js", "packages/sentencex_wasm_bg.wasm"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "options_page": "options.html"
}
