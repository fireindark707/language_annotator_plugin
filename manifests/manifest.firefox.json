{
  "manifest_version": 2,
  "name": "__MSG_appName__",
  "version": "1.5.0",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com;",
  "permissions": [
    "activeTab",
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "https://translate.googleapis.com/*",
    "https://kateglo.lostfocus.org/*",
    "https://freedictionaryapi.com/*",
    "https://jotoba.de/*",
    "https://media.githubusercontent.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "scripts": ["lib/dictionary-utils.js", "lib/lemma-utils.js", "lib/translation-utils.js", "lib/storage-merge-utils.js", "packages/simplemma.bundle.js", "storage.js", "background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["packages/wordfreq.iife.js", "lib/wordfreq-utils.js", "lib/dictionary-utils.js", "lib/lemma-utils.js", "lib/translation-utils.js", "lib/sentence-splitter.js", "lib/example-utils.js", "lib/storage-merge-utils.js", "lib/content-ui.js", "lib/content-addword.js", "lib/content-selection.js", "lib/content-lookup-ui.js", "lib/content-page-processing.js", "lib/content-difficulty.js", "storage.js", "ui-i18n.js", "ui-tour.js", "ui-toast.js", "content.js"]
    }
  ],
  "web_accessible_resources": [
    "packages/sentencex_wasm.js",
    "packages/sentencex_wasm_bg.wasm",
    "epub-reader.html",
    "epub-reader.js",
    "lib/epub-parser.js",
    "lib/epub-shelf.js",
    "lib/mobi-adapter.js",
    "lib/pdf-adapter.js",
    "packages/pdfjs/pdf.min.mjs",
    "packages/pdfjs/pdf.worker.min.mjs",
    "lib/content-selection.js",
    "lib/content-difficulty.js",
    "lib/sentencex-preload.js",
    "packages/jszip.min.js",
    "packages/mobi.js"
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "language-annotator@phoenix000.local",
      "strict_min_version": "140.0",
      "strict_min_version_android": "142.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  }
}
